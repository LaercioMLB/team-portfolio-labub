                  "name": "FAQ 1",
                  "width": "fill_container",
                  "variant": {
                    "state": "open"
                  },
                  "descendants": {
                    "zTzso": {
                      "content": "Preciso saber de tecnologia para contratar?"
                    },
                    "OyEJM": {
                      "content": "Não. Você conta o problema do jeito que conseguir; a gente traduz em escopo e explica cada decisão sem jargão."
                    }
                  }
                },
                {
                  "id": "Hk8EU",
                  "type": "ref",
                  "ref": "TH48K",
                  "name": "FAQ 2",
                  "width": "fill_container",
                  "variant": {
                    "state": "default"
                  },
                  "descendants": {
                    "ISePM": {
                      "content": "Quanto custa um projeto com a Labub?"
                    },
                    "o9jntU": {
                      "content": "Depende do tamanho e do prazo. Depois da primeira conversa, a gente manda uma proposta com escopo, etapas e valor. Você decide com tudo na mesa."
                    }
                  }
                },
                {
                  "id": "asO4i",
                  "type": "ref",
                  "ref": "TH48K",
                  "name": "FAQ 3",
                  "width": "fill_container",
                  "variant": {
                    "state": "default"
                  },
                  "descendants": {
                    "ISePM": {
                      "content": "Quanto tempo leva?"
                    },
                    "o9jntU": {
                      "content": "Depende do escopo. O prazo entra na proposta, dividido por etapas, antes de qualquer linha de código."
                    }
                  }
                },
                {
                  "id": "cBNqT",
                  "type": "ref",
                  "ref": "TH48K",
                  "name": "FAQ 4",
                  "width": "fill_container",
                  "variant": {
                    "state": "default"
                  },
                  "descendants": {
                    "ISePM": {
                      "content": "Vocês pegam projeto que já começou?"
                    },
                    "o9jntU": {
                      "content": "Sim. Começa com um diagnóstico do que existe (código, infraestrutura e custos) para decidir o que vale manter."
                    }
                  }
                },
                {
                  "id": "D2y5N",
                  "type": "ref",
                  "ref": "TH48K",
                  "name": "FAQ 5",
                  "width": "fill_container",
                  "variant": {
                    "state": "default"
                  },
                  "descendants": {
                    "ISePM": {
                      "content": "Como eu acompanho o andamento?"
                    },
                    "o9jntU": {
                      "content": "Com entregas por etapa e atualizações constantes. Você vê o produto evoluir, não só um relatório."
                    }
                  }
                },
